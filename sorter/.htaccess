# Local-only. The sorter holds real tax documents. Only a browser on this machine may reach it.
# api.php also refuses non-local requests itself, because some hosts ignore .htaccess.
<IfModule mod_authz_core.c>
  Require local
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
  Allow from 127.0.0.1 ::1
</IfModule>
