# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# fetched source dumps used while checking figures
/agent-tools

# tax documents staged or sorted locally
/sorter/stage/*
!/sorter/stage/.gitkeep
/sorter/_Last year's return/
/sorter/_Proof of identity/
/sorter/Deductions/
/sorter/Income - Investments/
/sorter/Income - Rental/
/sorter/Income - Self-employment/
/sorter/Regulations - Health Insurance/
