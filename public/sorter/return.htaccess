# A tax-year folder: never served directly. api.php lists, reads, places, and removes files on disk.
# Uploads keep their own names, so PHP is switched off here in case a host serves this folder.
# nginx ignores .htaccess entirely: use the location blocks in docs/NGINX.md instead.
# api.php copies this file from return.htaccess beside itself when it creates a Tax Year folder.

# Apache 2.4+
<IfModule mod_authz_core.c>
  Require all denied
  <Files "*">
    Require all denied
  </Files>
</IfModule>

# Apache 2.2 fallback
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
  <Files "*">
    Order allow,deny
    Deny from all
  </Files>
</IfModule>

<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
<IfModule mod_php5.c>
  php_flag engine off
</IfModule>
