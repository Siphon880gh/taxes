# Copy this file to .env (never commit .env) and fill in what you use.

# --- Document Sorter endpoint -------------------------------------------------------------------
# Inlined into the app by `npm run dev` and `npm run build`. Point it at the URL where PHP serves sorter/api.php.
# On a host other than localhost, a localhost URL here is skipped and the app calls ../sorter/api.php next to out/.
SERVER_URL_UPLOAD_API_PHP=http://localhost:8888/path/to/sorter/api.php

# --- In-app ChatGPT / Claude (optional) ----------------------------------------------------------
# Read only by sorter/api.php on the server; never inlined into the app or sent to the browser.
# These keys power Ask AI to sort, write Summaries.md, audit what the return owes, and the FreeTaxUSA
# walkthrough. The server reads the matching skill from .agents/skills/ and follows it.
#
# Leave both keys unset and the attempt stops with a message: the API key or billing is not set up,
# and which skill to run in your own AI harness (Cursor, Claude Code, ...) on that tax year and folder.
# A provider refusal for billing, quota, or an invalid key stops the same way.
#
# One key is enough. With both set, AI_PROVIDER picks; without AI_PROVIDER, OpenAI is tried first.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
#
# Which provider to use: openai (ChatGPT) or anthropic (Claude). Optional. chatgpt and claude are accepted too.
# AI_PROVIDER=openai
#
# Model name for that provider. Optional; defaults: gpt-4.1-mini (OpenAI), claude-sonnet-4-5 (Anthropic).
# AI_MODEL=gpt-4.1-mini
#
# Other API base URLs (an OpenAI-compatible proxy, a local test server). Optional.
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com
